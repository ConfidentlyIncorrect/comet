# ── Self-hosted Comet stack config ──────────────────────────────────────────
# Copy to `.env` and edit. Bring up with:
#   docker compose -f deployment/selfhost/docker-compose.yml --env-file deployment/selfhost/.env up -d --build

# Prowlarr API key — leave blank for the FIRST boot, then grab it from the Prowlarr UI
# (http://<vps>:9696 → Settings → General → API Key), paste here, and re-run `up -d`.
PROWLARR_API_KEY=

# linuxserver/prowlarr file ownership + timezone
PUID=1000
PGID=1000
TZ=Etc/UTC
FLARESOLVERR_LOG_LEVEL=info

# Re-scrape on EVERY stream request (Prowlarr + all scrapers) and merge new torrents onto whatever is
# already cached — so results are always complete and current. Set to False to use Comet's default
# 7-day "fresh" cache that serves instantly but won't pick up new releases until the cache expires.
ALWAYS_RESCRAPE=True

# How ALWAYS_RESCRAPE behaves when a cache already exists:
#   True  = background: return cached results INSTANTLY, run the scrape behind the request. Opens stay
#           fast no matter how slow the indexers are; new finds show up on the next open. Recommended,
#           especially with Cloudflare-gated indexers (1337x etc.) that take many seconds to solve.
#   False = foreground: block until the scrape finishes so cached + fresh are in the SAME response
#           (slower opens, but newest results appear immediately).
# Either way, the very first open of a never-seen title scrapes in the foreground (empty cache).
ALWAYS_RESCRAPE_BACKGROUND=True

# How long Comet waits on a Prowlarr search. With several indexers and TWO Cloudflare-gated ones,
# Byparr (one browser) solves challenges serially, so a cold sweep needs well over 60s — 120s gives
# headroom. With ALWAYS_RESCRAPE_BACKGROUND=True this runs behind the request, so a long timeout does
# NOT slow down opening a title (only the first, empty-cache open waits). Raise if you add more
# Cloudflare indexers.
INDEXER_MANAGER_TIMEOUT=120
INDEXER_MANAGER_WAIT_TIMEOUT=120

# Time to fetch each individual torrent/magnet from Prowlarr's /download proxy. The 5s default
# silently drops most results ("Failed to download torrent ... TimeoutError"): for indexers without a
# direct magnet (1337x and friends) Prowlarr fetches the torrent page itself — via FlareSolverr for
# Cloudflare ones — which takes much longer than 5s. With background scraping this never delays opens.
GET_TORRENT_TIMEOUT=65

# How many torrent files Comet fetches at once. Cloudflare indexers (1337x etc.) resolve every
# .torrent through Byparr's single browser; fetching them all in parallel makes them share one
# timeout window so the browser only clears a few and the rest fail together. Capping concurrency
# lets each batch use its full GET_TORRENT_TIMEOUT, so far more results survive. Lower (4-6) if you
# rely heavily on Cloudflare indexers; raise it if your indexers return magnets directly. 0 = no cap.
GET_TORRENT_CONCURRENCY=8

# ── Solver (Byparr) runs DIRECTLY on the VPS IP — no VPN ─────────────────────
# A VPN exit makes Cloudflare serve a harder challenge AND binds the cf_clearance cookie to the wrong
# IP, both of which break the solve. The VPS IP gets the normal (solvable) check. If your VPS IP ever
# DOES get hard-blocked, the gluetun-sidecar version is in git history (commit before this one).

# ── Extra free scrapers (work out of the box, no indexer setup needed) ───────
# These use Comet's built-in public default URLs and give immediate coverage on top of Prowlarr.
SCRAPE_ZILEAN=True
SCRAPE_TORRENTIO=True
SCRAPE_STREMTHRU=True
# TheRARBG — native GET-JSON scraper (this fork). Magnet-first, not Cloudflare-gated, no Byparr.
SCRAPE_THERARBG=True

# ── Notes ────────────────────────────────────────────────────────────────────
# • Debrid (AllDebrid / TorBox) keys are NOT set here — you enter them per-user in Comet's config
#   page (http://<vps>:8000) which generates the install URL for Nuvio.
# • The TheTVDB "#DUPE#" fix is baked into the image (built from this repo); nothing to configure.
