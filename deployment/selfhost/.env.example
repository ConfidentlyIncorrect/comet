# ── Self-hosted Comet stack config ──────────────────────────────────────────
# Copy to `.env` and edit. Bring up with:
#   docker compose -f deployment/selfhost/docker-compose.yml --env-file deployment/selfhost/.env up -d --build

# Prowlarr API key — leave blank for the FIRST boot, then grab it from the Prowlarr UI
# (http://<vps>:9696 → Settings → General → API Key), paste here, and re-run `up -d`.
PROWLARR_API_KEY=

# linuxserver/prowlarr file ownership + timezone
PUID=1000
PGID=1000
TZ=Etc/UTC
FLARESOLVERR_LOG_LEVEL=info

# ── Extra free scrapers (work out of the box, no indexer setup needed) ───────
# These use Comet's built-in public default URLs and give immediate coverage on top of Prowlarr.
SCRAPE_ZILEAN=True
SCRAPE_TORRENTIO=True
SCRAPE_STREMTHRU=True

# ── Notes ────────────────────────────────────────────────────────────────────
# • Debrid (AllDebrid / TorBox) keys are NOT set here — you enter them per-user in Comet's config
#   page (http://<vps>:8000) which generates the install URL for Nuvio.
# • The TheTVDB "#DUPE#" fix is baked into the image (built from this repo); nothing to configure.
